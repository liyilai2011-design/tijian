# Copy this file to .env in the project root. Do not commit .env.
# Relative file paths resolve from the project root, not backend/.
DATABASE_URL=sqlite:///data/healthcheck.db
DATA_DIR=data
REPORTS_DIR=data/reports

# Local development uses HTTP. Change to true when using production HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=8
# Exam numbering applies to new exams only; existing numbers remain unchanged.
# date_sequence example: 20261002-0001. random uses a 12-character random suffix.
EXAM_NUMBER_MODE=date_sequence
EXAM_NUMBER_PREFIX=
EXAM_NUMBER_DATE_FORMAT=%Y%m%d
EXAM_NUMBER_WIDTH=4
EXAM_NUMBER_SEPARATOR=-
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# backup.py only; the application does not need to read this key.
BACKUP_DIR=backups

# Production PostgreSQL example: replace all placeholders in your private .env.
# Encode special characters in URL usernames/passwords. Never use this example literally.
# DATABASE_URL=postgresql+psycopg://healthcheck:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/healthcheck
# COOKIE_SECURE=true
# ALLOWED_ORIGINS=["https://192.168.1.100"]

# There are no built-in passwords. The CLI asks you to set the administrator password.
